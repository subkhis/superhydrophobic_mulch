Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sensitivity", " ", "analysis"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Given", " ", "values", " ", "and", " ", "uncertainties"}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"bMean", "=", "b"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bErr", "=", "9.43066"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lcMean", "=", "81.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lcErr", "=", "1.0"}], ";"}], " ", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "nominal", " ", "lp"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lpNominal", "=", 
     RowBox[{
      RowBox[{"2", "*", "Pi", "*", "bMean"}], "-", "lcMean"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Propagated", " ", "standard", " ", "error", " ", "for", " ", "lp"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lpErr", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "*", "Pi", "*", "bErr"}], ")"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "*", "lcErr"}], ")"}], "^", "2"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<lp + lc (mm):\>\"", ",", 
      RowBox[{"2", "*", "Pi", "*", "bMean"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Nominal lp (mm): \>\"", ",", "lpNominal"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Propagated Error sigma_lp (mm): \>\"", ",", "lpErr"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Range for lp: \>\"", ",", 
      RowBox[{"lpNominal", "-", "lpErr"}], ",", "\"\< to \>\"", ",", 
