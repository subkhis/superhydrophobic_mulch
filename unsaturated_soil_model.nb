            FractionBox[
             RowBox[{"(", 
              RowBox[{"wt", "-", "a"}], ")"}], "b"], "]"}]}], ")"}]}], ")"}], 
       
       RowBox[{"Jw", "[", "H", "]"}]}], "+", 
